{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cloudflow-media-pipeline-ap-south-1/*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::cloudflow-media-pipeline-ap-south-1/*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::cloudflow-media-pipeline-ap-south-1/*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::cloudflow-media-pipeline-ap-south-1"
    },
    {
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:ap-south-1:686420703711:cloudflow-image-processing"
    },
    {
      "Effect": "Allow",
      "Action": "sqs:ReceiveMessage",
      "Resource": "arn:aws:sqs:ap-south-1:686420703711:cloudflow-image-processing"
    },
    {
      "Effect": "Allow",
      "Action": "sqs:DeleteMessage",
      "Resource": "arn:aws:sqs:ap-south-1:686420703711:cloudflow-image-processing"
    },
    {
      "Effect": "Allow",
      "Action": "sqs:ChangeMessageVisibility",
      "Resource": "arn:aws:sqs:ap-south-1:686420703711:cloudflow-image-processing"
    },
    {
      "Effect": "Allow",
      "Action": "sqs:GetQueueAttributes",
      "Resource": "arn:aws:sqs:ap-south-1:686420703711:cloudflow-image-processing"
    }
  ]
}
