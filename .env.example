APP_NAME=CloudFlow
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://cloudflow:cloudflow@db:5432/cloudflow
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRE_MINUTES=60
AWS_REGION=ap-south-1
AWS_PROFILE=default
AWS_S3_BUCKET=replace-with-private-bucket-name
AWS_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT_ID/cloudflow-jobs
AWS_SQS_VISIBILITY_TIMEOUT=180
AWS_ENDPOINT_URL=
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
MAX_UPLOAD_BYTES=10485760
PRESIGNED_URL_SECONDS=300
LOG_LEVEL=INFO
# Local Compose default only; use a strong alphanumeric value on EC2.
POSTGRES_PASSWORD=replace-with-local-password




